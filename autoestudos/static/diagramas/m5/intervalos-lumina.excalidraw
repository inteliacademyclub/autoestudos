   "isDeleted": false,
   "boundElements": null,
   "updated": 1790546099108,
   "link": null,
   "locked": false,
   "text": "Em log, cada intervalo é simétrico.\nEm curtidas, a cauda de cima é mais longa:\nB vai de −2.080 a +3.920 em torno de 4.380.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "n1",
   "originalText": "Em log, cada intervalo é simétrico.\nEm curtidas, a cauda de cima é mais longa:\nB vai de −2.080 a +3.920 em torno de 4.380.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
