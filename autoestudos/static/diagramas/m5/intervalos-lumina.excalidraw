   "versionNonce": 1456649252,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790546099108,
   "link": null,
   "locked": false,
   "text": "Os intervalos se tocam entre 2.300 e 2.800.\nMesmo assim, P(B > A) ≈ 0,94 com erros independentes:\nsobreposição não significa empate.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "center",
