   "boundElements": null,
   "updated": 1790545654913,
   "link": null,
   "locked": false,
   "text": "Na simulação da aula, o ACI volta para ~80% de cobertura\nem poucas semanas, pagando com intervalos ~1,6× mais largos.\nCom o atraso real de 30 dias, a volta é mais lenta.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "resumo",
   "originalText": "Na simulação da aula, o ACI volta para ~80% de cobertura\nem poucas semanas, pagando com intervalos ~1,6× mais largos.\nCom o atraso real de 30 dias, a volta é mais lenta.",
   "autoResize": true,
   "lineHeight": 1.25
  }
