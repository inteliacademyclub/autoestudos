   "version": 3,
   "versionNonce": 1023060924,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790545535427,
   "link": null,
   "locked": false,
   "text": "Regra do rótulo: um Short só entra no treino\ncom ≥ 30 dias de vida. Coleta em 28/09 rotula\nvídeos publicados até 29/08; coleta em 19/10,\nvídeos publicados até 19/09.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "regra",
   "originalText": "Regra do rótulo: um Short só entra no treino\ncom ≥ 30 dias de vida. Coleta em 28/09 rotula\nvídeos publicados até 29/08; coleta em 19/10,\nvídeos publicados até 19/09.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "S-QfDLwPy9T_ooQ22pVr5",
   "type": "text",
   "x": 690.8001708984375,
   "y": 282.5,
   "width": 538.399658203125,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
