   "seed": 739862716,
   "version": 3,
   "versionNonce": 639892996,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790545535427,
   "link": null,
   "locked": false,
   "text": "A cota (10.000 unidades) zera à meia-noite do\nPacífico: 04h em Brasília até 01/11/2026 (05h depois).\nUnidade não usada hoje não acumula para amanhã.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "cota",
   "originalText": "A cota (10.000 unidades) zera à meia-noite do\nPacífico: 04h em Brasília até 01/11/2026 (05h depois).\nUnidade não usada hoje não acumula para amanhã.",
   "autoResize": true,
   "lineHeight": 1.25
  },
