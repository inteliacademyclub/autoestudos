   "text": "Data card: origem, período, volume,\ntermos, vieses e o que a base\nNÃO representa",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "a3",
   "originalText": "Data card: origem, período, volume,\ntermos, vieses e o que a base\nNÃO representa",
   "autoResize": true,
