   "text": "Metadados e estatísticas via\nYouTube Data API, com data de coleta\n(collected_at) em cada linha",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "a1",
   "originalText": "Metadados e estatísticas via\nYouTube Data API, com data de coleta\n(collected_at) em cada linha",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "CM_JNDgoaurZ_mjkIpL8t",
   "type": "text",
   "x": 59.464141845703125,
   "y": 235,
   "width": 281.07171630859375,
