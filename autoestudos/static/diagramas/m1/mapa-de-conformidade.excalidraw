   "seed": 139927138,
   "version": 3,
   "versionNonce": 1513286626,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790545794633,
   "link": null,
   "locked": false,
   "text": "Alvo relativo, faixas e outras métricas\nderivadas: tensão com III.E.4.h.\nUso interno e educacional, sem exibir\ncomo \"métrica do YouTube\"",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b1",
   "originalText": "Alvo relativo, faixas e outras métricas\nderivadas: tensão com III.E.4.h.\nUso interno e educacional, sem exibir\ncomo \"métrica do YouTube\"",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "2Q5Q2q4GmJXK2NcaseQKz",
   "type": "text",
   "x": 486.8161315917969,
   "y": 235,
   "width": 306.36773681640625,
   "height": 60,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aL",
   "roundness": null,
   "seed": 375980578,
   "version": 3,
   "versionNonce": 1202436926,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790545794633,
   "link": null,
   "locked": false,
   "text": "Gemini no free tier: o Google pode usar\no que você envia e revisores humanos\npodem ler. Nada sensível ou pessoal",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b2",
   "originalText": "Gemini no free tier: o Google pode usar\no que você envia e revisores humanos\npodem ler. Nada sensível ou pessoal",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "JKG6W4UfUjGPEf5oHxwMs",
   "type": "text",
   "x": 485.5601348876953,
   "y": 365,
   "width": 308.8797302246094,
   "height": 60,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aM",
   "roundness": null,
   "seed": 403205602,
   "version": 3,
   "versionNonce": 644816802,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790545794633,
   "link": null,
   "locked": false,
   "text": "Comentários, rostos e vozes são dados\npessoais (LGPD): colete só se precisar,\nminimize e não publique",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b3",
