  },
  {
   "id": "OnMVnfg15Kle3_yyTwnmt",
   "type": "text",
   "x": 490.1041564941406,
   "y": 95,
   "width": 299.79168701171875,
   "height": 80,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
